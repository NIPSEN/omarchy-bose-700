[Unit]
Description=Bose NC Headphones 700 Headless Bluetooth Daemon
PartOf=graphical-session.target
After=bluetooth.target graphical-session.target
# The socket is created by the service manager before the daemon starts, and
# outlives daemon restarts.
Requires=bose-700.socket
After=bose-700.socket

[Service]
Type=simple
ExecStart=%h/.local/bin/bose-700-daemon
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=graphical-session.target
Also=bose-700.socket
